extends SceneTree

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	assert(ClassDB.class_exists("VextoriaExplorerTree"), "native Explorer control is missing")
	var source := Node.new()
	source.name = "Workspace"
	root.add_child(source)
	var explorer: Tree = ClassDB.instantiate("VextoriaExplorerTree")
	explorer.set_select_mode(Tree.SELECT_MULTI)
	root.add_child(explorer)
	explorer.call("set_source_root", source)
	var source_item: TreeItem = explorer.call("get_item_for_node", source)
	assert(source_item != null and source_item.get_text(0) == "Workspace")

	var model: Node3D = ClassDB.instantiate("Model")
	model.name = "House"
	model.set_meta("_vextoria_instance", true)
	model.set_meta("_vextoria_explorer_icon", ImageTexture.create_from_image(Image.create(2, 2, false, Image.FORMAT_RGBA8)))
	model.set_meta("_vextoria_explorer_renameable", true)
	model.set_meta("_vextoria_explorer_model_editable_color", true)
	source.add_child(model)
	var folder: Node = ClassDB.instantiate("Folder")
	folder.name = "Door Group"
	folder.set_meta("_vextoria_instance", true)
	model.add_child(folder)
	var implementation := Node.new()
	implementation.name = "Implementation"
	folder.add_child(implementation)
	var part: RigidBody3D = ClassDB.instantiate("Part")
	part.name = "Door"
	part.set_meta("_vextoria_instance", true)
	implementation.add_child(part)
	var model_item: TreeItem = explorer.call("get_item_for_node", model)
	var folder_item: TreeItem = explorer.call("get_item_for_node", folder)
	var part_item: TreeItem = explorer.call("get_item_for_node", part)
	var native_selection_events: Array = []
	explorer.connect("instance_selected", func(node: Node, selected: bool) -> void:
		native_selection_events.append([node, selected])
	)
	assert(model_item.get_parent() == source_item, "Model is not under Workspace")
	assert(model_item.get_icon(0) == model.get_meta("_vextoria_explorer_icon"), "native Tree did not apply the Node-owned class icon")
	assert(model_item.is_editable(0), "native Tree did not apply Node-owned rename policy")
	assert(model_item.get_custom_color(0) == Color("#FFBC58"), "native Tree did not apply linked-model child color")
	assert(model_item.is_collapsed(), "native Tree did not collapse a newly admitted non-root row")
	assert(model_item.has_meta("_vextoria_presentation_initialized"), "native Tree did not record its presentation initialization")
	assert(not model_item.has_meta("_vextoria_decorated"), "native presentation bypassed Creator's deferred-decoration completion marker")
	assert(folder_item.get_parent() == model_item, "Folder is not under Model")
	assert(part_item.get_parent() == folder_item, "Part must skip unmarked implementation Node")
	assert(explorer.call("get_item_for_node", implementation) == null, "implementation Node leaked into Explorer")
	assert(part_item.get_child_count() == 0, "native Part internals leaked into Explorer")
	assert(not part_item.is_editable(0), "native Tree made a row editable without Node presentation metadata")
	assert(explorer.call("get_node_for_item", part_item) == part, "item identity did not resolve to native Part")
	explorer.emit_signal("multi_selected", part_item, 0, true)
	explorer.emit_signal("multi_selected", part_item, 0, false)
	assert(native_selection_events == [[part, true], [part, false]], "native Tree did not emit selection changes with mapped gameplay Node identity")
	native_selection_events.clear()
	assert(explorer.call("set_instance_selected", part, true), "native Explorer rejected selection of a mapped Instance")
	assert(part_item.is_selected(0), "native Explorer did not select the mapped row")
	assert(not model_item.is_collapsed() and not folder_item.is_collapsed(), "native Explorer selection did not expand ancestors")
	assert(native_selection_events.is_empty(), "native programmatic selection incorrectly emitted a user-input event")
	assert(explorer.call("set_instance_selected", part, false), "native Explorer rejected deselection of a mapped Instance")
	assert(not part_item.is_selected(0), "native Explorer did not deselect the mapped row")
	assert(native_selection_events.is_empty(), "native programmatic deselection incorrectly emitted a user-input event")
	model_item.set_collapsed(true)
	folder_item.set_collapsed(true)
	explorer.set_select_mode(Tree.SELECT_SINGLE)
	assert(explorer.call("set_instance_selected", part, true), "native Explorer rejected single-select of a mapped Instance")
	assert(part_item.is_selected(0), "native Explorer failed single-select beneath collapsed ancestors")
	assert(not model_item.is_collapsed() and not folder_item.is_collapsed(), "single-select did not expand ancestors before selecting")
	explorer.call("set_instance_selected", part, false)
	assert(not explorer.call("set_instance_selected", implementation, true), "native Explorer selected an unrepresented helper Node")
	assert(part_item.get_metadata(0) == null, "native node identity was duplicated in TreeItem metadata")
	var excluded := Node.new()
	excluded.set_meta("_vextoria_instance", true)
	excluded.set_meta("_vextoria_explorer_excluded", true)
	source.add_child(excluded)
	var excluded_child := Node.new()
	excluded_child.set_meta("_vextoria_instance", true)
	excluded.add_child(excluded_child)
	assert(explorer.call("get_item_for_node", excluded) == null, "excluded node leaked into Explorer")
	assert(explorer.call("get_item_for_node", excluded_child) == null, "excluded descendant leaked into Explorer")
	assert(explorer.call("is_node_excluded", excluded), "native Explorer did not identify excluded node")
	assert(explorer.call("is_node_excluded", excluded_child), "native Explorer did not identify excluded ancestry")
	assert(not explorer.call("is_node_excluded", model), "native Explorer incorrectly excluded a visible node")
	var link_icon := ImageTexture.create_from_image(Image.create(2, 2, false, Image.FORMAT_RGBA8))
	var lock_icon := ImageTexture.create_from_image(Image.create(2, 2, false, Image.FORMAT_RGBA8))
	model.set_meta("_vextoria_explorer_link_icon", link_icon)
	model.set_meta("_vextoria_explorer_link_tooltip", "Linked Model (fixture)")
	model.set_meta("_vextoria_explorer_linked", true)
	model.set_meta("_vextoria_explorer_lock_icon", lock_icon)
	model.set_meta("_vextoria_explorer_locked", true)
	assert(explorer.call("refresh_node_presentation", model), "native presentation refresh rejected a mapped Node")
	assert(model_item.get_button_by_id(0, 1) >= 0, "native Tree did not display linked-model badge")
	assert(model_item.get_button_tooltip_text(0, model_item.get_button_by_id(0, 1)) == "Linked Model (fixture)", "native Tree lost linked-model tooltip")
	assert(model_item.get_button_by_id(0, 2) >= 0, "native Tree did not display locked badge")
	model.set_meta("_vextoria_explorer_linked", false)
	model.set_meta("_vextoria_explorer_locked", false)
	explorer.call("refresh_node_presentation", model)
	assert(model_item.get_button_by_id(0, 1) < 0 and model_item.get_button_by_id(0, 2) < 0, "native Tree did not remove cleared presentation badges")

	part.name = "Red Door"
	assert(part_item.get_text(0) == "Red Door", "native rename was not reflected")
	part_item.set_text(0, "Rejected Rename")
	explorer.call("sync_item_name", part_item)
	assert(part_item.get_text(0) == part.name, "native row did not restore its authoritative Node name")
	folder_item.set_meta("_model_non_editable", true)
	var search_result: Node = explorer.call("apply_search_filter", "red")
	assert(search_result == part, "native search did not return the first matching Node")
	assert(part_item.is_visible(), "native search hid the matching row")
	assert(folder_item.is_visible() and model_item.is_visible(), "native search did not reveal matching ancestors")
	search_result = explorer.call("apply_search_filter", "no such instance")
	assert(search_result == null, "native search returned a result for a non-matching query")
	assert(not part_item.is_visible(), "native no-match search left a non-matching row visible")
	explorer.call("apply_search_filter", "")
	assert(not folder_item.is_visible(), "clearing native search ignored Creator model visibility state")
	assert(part_item.is_visible(), "clearing native search failed to restore an ordinary row")
	folder_item.set_meta("_model_non_editable", false)
	var second: Node3D = ClassDB.instantiate("Model")
	second.name = "Other House"
	second.set_meta("_vextoria_instance", true)
	source.add_child(second)
	folder.reparent(second, true)
	var moved_item: TreeItem = explorer.call("get_item_for_node", folder)
	assert(moved_item.get_parent() == explorer.call("get_item_for_node", second), "reparent did not follow SceneTree")
	assert(explorer.call("get_item_for_node", part) != null, "nested Part vanished during reparent")
	source.move_child(second, 0)
	await process_frame
	await process_frame
	assert(source_item.get_first_child() == explorer.call("get_item_for_node", second), "native order did not follow SceneTree")
	folder.free()
	assert(not is_instance_valid(moved_item), "removed Folder item remained in Explorer")
	source.free()
	assert(explorer.call("get_source_root") == null, "freed source root remained bound")
	var detached := Node.new()
	explorer.call("set_source_root", detached)
	var late_child := Node.new()
	late_child.set_meta("_vextoria_instance", true)
	detached.add_child(late_child)
	assert(explorer.call("get_item_for_node", late_child) == null, "detached node should await explicit admission")
	assert(explorer.call("ensure_item_for_node", late_child) != null, "detached Creator world cannot admit a new item")
	var pending_parent := Node.new()
	pending_parent.set_meta("_vextoria_instance", true)
	detached.add_child(pending_parent)
	var pending_child := Node.new()
	pending_child.set_meta("_vextoria_instance", true)
	pending_parent.add_child(pending_child)
	var pending_child_item: TreeItem = explorer.call("ensure_item_for_node", pending_child)
	assert(pending_child_item.get_parent() == explorer.call("get_item_for_node", pending_parent), "out-of-order admission lost the native parent")
	explorer.call("set_source_root", null)
	detached.free()
	explorer.free()
	print("VEXTORIA_NATIVE_EXPLORER_PASS: hierarchy, identity, rename, reparent, order, removal")
	quit(0)
